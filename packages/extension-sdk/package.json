{
  "name": "folyn-extension-sdk",
  "version": "0.1.2",
  "description": "Folyn Extension SDK — manifest schema, contribution points, contracts, and dev helpers. Publishable to npm; no runtime.",
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts",
      "default": "./index.ts"
    }
  },
  "files": [
    "dist",
    "index.ts",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": "^18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
