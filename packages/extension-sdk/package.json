{
  "name": "folyn-extension-sdk",
  "version": "0.2.0",
  "description": "Folyn Extension SDK — manifest schema, contribution points, contracts, and dev helpers. Type-only at runtime; publishable to npm.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "license": "MIT",
  "author": "linyimin",
  "repository": {
    "type": "git",
    "url": "https://github.com/linyimin0812/folyn.git",
    "directory": "packages/extension-sdk"
  },
  "homepage": "https://github.com/linyimin0812/folyn/tree/master/packages/extension-sdk",
  "bugs": {
    "url": "https://github.com/linyimin0812/folyn/issues"
  },
  "keywords": [
    "folyn",
    "extension",
    "sdk",
    "plugin",
    "markdown-editor"
  ],
  "peerDependencies": {
    "react": "^18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
