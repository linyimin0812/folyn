{
  "name": "@quill/plugin-plantuml",
  "version": "0.1.0",
  "description": "Quill trusted-tier plugin — PlantUML (.puml) file-type viewer using plantuml-encoder + public plantuml.com server.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "plantuml-encoder": "^1.4.0"
  },
  "devDependencies": {
    "quill-plugin-sdk": "workspace:*",
    "@testing-library/react": "^16.0.0",
    "@types/plantuml-encoder": "^1.4.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8",
    "jsdom": "^25.0.1"
  }
}
