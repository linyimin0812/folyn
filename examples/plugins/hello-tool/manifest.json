{
  "id": "hello-tool",
  "name": "Hello Tool",
  "version": "1.0.0",
  "author": "Quill Examples",
  "quill": ">=0.1.0",
  "tier": "sandbox",
  "main": "index.js",
  "html": "index.html",
  "permissions": {
    "clipboard": true
  },
  "contributes": {
    "commands": [
      { "id": "greet", "title": "Hello: Greet", "icon": "👋", "run": "greet" }
    ],
    "tools": [
      { "id": "hello", "title": "Hello Tool", "window": true, "entry": "index.html" }
    ]
  },
  "activation": { "onCommand": "greet" }
}
