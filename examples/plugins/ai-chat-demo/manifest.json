{
  "id": "ai-chat-demo",
  "name": "AI Chat Demo (Trusted)",
  "version": "1.0.0",
  "author": "Quill Examples",
  "quill": ">=0.1.0",
  "tier": "trusted",
  "main": "index.js",
  "permissions": {
    "ai": { "chat": true, "agents": ["study"] }
