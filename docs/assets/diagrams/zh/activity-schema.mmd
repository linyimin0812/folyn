%% Folyn 活动采集 SQLite schema（~/.folyn/activity/<vault-key>/activity.sqlite，每 vault 一库）
%% 注：relations 的三个外键为显式 REFERENCES；actor_entity_id 与 collector_id↔source 为逻辑关联（无约束）
erDiagram
    entities {
        TEXT id PK
        TEXT type
        TEXT identity_key
        TEXT display_name
        TEXT metadata_json
        INTEGER created_at
    }
    activity_events {
        TEXT id PK
        TEXT type
        TEXT source
        TEXT actor_entity_id FK
        INTEGER occurred_at
        INTEGER created_at
        TEXT title
        TEXT summary
        TEXT url
        TEXT payload_json
        TEXT raw_json
        TEXT ai_summary
    }
    relations {
        TEXT id PK
        TEXT from_entity_id FK
        TEXT to_entity_id FK
        TEXT relation_type
        TEXT activity_event_id FK
        INTEGER occurred_at
    }
    collector_cursors {
        TEXT collector_id PK
        TEXT cursor
        INTEGER updated_at
    }
    collect_runs {
        INTEGER id PK
        TEXT collector_id
        TEXT collector_name
        INTEGER started_at
        INTEGER finished_at
        INTEGER accepted
        INTEGER deduped
        TEXT outcome
        TEXT logs
    }

    entities ||--o{ activity_events : "actor"
    entities ||--o{ relations : "from_entity"
    entities ||--o{ relations : "to_entity"
    activity_events ||--o{ relations : "event"
    collector_cursors ||..o{ activity_events : "source"
    collect_runs ||..o{ activity_events : "source"
