{
  "name": "quill",
  "private": true,
  "version": "0.1.0",
  "description": "Quill — AI-enhanced local-first Markdown editor",
  "scripts": {
    "dev": "pnpm --filter @quill/desktop dev",
    "dev:voice": "pnpm --filter @quill/desktop dev:voice",
    "build": "pnpm --filter @quill/desktop... build",
    "build:app": "cd apps/desktop && pnpm tauri build",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@vitest/coverage-v8": "^2.1.8",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "dependencies": {
    "d3-force": "^3.0.0"
  },
  "pnpm": {
    "patchedDependencies": {
      "@file-viewer/renderer-spreadsheet@2.1.17": "patches/@file-viewer__renderer-spreadsheet@2.1.17.patch",
      "e-virt-table@1.4.2": "patches/e-virt-table@1.4.2.patch",
      "mind-elixir@5.14.0": "patches/mind-elixir@5.14.0.patch"
    },
    "overrides": {
      "@file-viewer/renderer-spreadsheet": "2.1.17"
    }
  }
}
