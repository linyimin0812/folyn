{
  "name": "quill",
  "private": true,
  "version": "0.1.0",
  "description": "Quill — AI-enhanced local-first Markdown editor",
  "scripts": {
    "dev": "pnpm --filter @quill/desktop dev",
    "build": "pnpm --filter @quill/desktop build",
    "build:app": "cd apps/desktop && pnpm tauri build",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "dependencies": {
    "d3-force": "^3.0.0"
  }
}
