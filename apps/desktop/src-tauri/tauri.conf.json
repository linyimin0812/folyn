{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri/v2/tooling/cli/schema.json",
  "productName": "Mochi",
  "version": "0.1.0",
  "identifier": "com.mochi.editor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdx", "mdown", "mkd"],
        "name": "Mochi Markdown",
        "role": "Editor",
        "mimeType": "text/markdown"
      },
      {
        "ext": ["richtext"],
        "name": "Mochi Rich Text",
        "role": "Editor",
        "mimeType": "text/plain"
      },
      {
        "ext": ["markmap"],
        "name": "Mochi Markmap",
        "role": "Editor",
        "mimeType": "application/json"
      },
      {
        "ext": ["mermaid", "mmd"],
        "name": "Mochi Mermaid",
        "role": "Editor",
        "mimeType": "text/plain"
      },
      {
        "ext": ["puml", "pu", "plantuml"],
        "name": "Mochi PlantUML",
        "role": "Editor",
        "mimeType": "text/plain"
      },
      {
        "ext": ["gv", "dot", "graphviz"],
        "name": "Mochi Graphviz",
        "role": "Editor",
        "mimeType": "text/plain"
      },
      {
        "ext": ["drawio", "dio"],
        "name": "Mochi Drawio",
        "role": "Editor",
        "mimeType": "application/xml"
      },
      {
        "ext": ["excalidraw"],
        "name": "Mochi Excalidraw",
        "role": "Editor",
        "mimeType": "application/json"
      },
      {
        "ext": ["dbml"],
        "name": "Mochi DBML",
        "role": "Editor",
        "mimeType": "text/plain"
      },
      {
        "ext": ["svg"],
        "name": "Mochi SVG",
        "role": "Editor",
        "mimeType": "image/svg+xml"
      },
      {
        "ext": ["html", "htm"],
        "name": "Mochi HTML",
        "role": "Editor",
        "mimeType": "text/html"
      },
      {
        "ext": ["json"],
        "name": "Mochi JSON",
        "role": "Editor",
        "mimeType": "application/json"
      },
      {
        "ext": ["csv", "tsv"],
        "name": "Mochi CSV",
        "role": "Editor",
        "mimeType": "text/csv"
      },
      {
        "ext": ["png", "jpg", "jpeg", "gif", "webp", "bmp", "ico", "tiff", "tif", "avif", "heic", "heif", "jxl"],
        "name": "Mochi Image",
        "role": "Viewer",
        "mimeType": "image/*"
      },
      {
        "ext": ["txt", "text", "log", "json5", "yaml", "yml", "xml", "css", "js", "ts", "toml", "ini", "rst", "tex"],
        "name": "Mochi Text",
        "role": "Viewer",
        "mimeType": "text/plain"
      },
      {
        "ext": ["pdf", "ofd", "docx", "doc", "dot", "docm", "dotx", "dotm", "rtf", "odt", "xlsx", "xls", "xlsm", "xlsb", "xltx", "xlt", "xltm", "ods", "fods", "numbers", "pptx", "pptm", "potx", "potm", "ppsx", "ppsm", "odp", "zip", "zipx", "7z", "rar", "tar", "gz", "gzip", "tgz", "bz2", "bzip2", "tbz", "tbz2", "xz", "txz", "lzma", "zst", "cab", "ar", "cpio", "iso", "xar", "lha", "lzh", "jar", "war", "ear", "apk", "cbz", "cbr", "eml", "msg", "mbox", "olb", "dra", "gds", "oas", "oasis", "dwg", "dxf", "dwf", "dwfx", "xps", "geojson", "kml", "gpx", "shp", "glb", "gltf", "obj", "stl", "ply", "fbx", "dae", "3ds", "3mf", "amf", "usd", "usda", "usdc", "usdz", "kmz", "pcd", "wrl", "vrml", "xyz", "vtk", "vtp", "step", "stp", "iges", "igs", "ifc", "3dm", "xmind", "epub", "umd", "mp3", "mpeg", "wav", "ogg", "oga", "opus", "m4a", "aac", "flac", "weba", "midi", "mid", "mp4", "webm", "m3u8", "ttf", "otf", "woff", "woff2", "psd", "ai", "eps", "sqlite", "wasm", "parquet", "avro", "webarchive"],
        "name": "Mochi Document",
        "role": "Viewer",
        "mimeType": "application/octet-stream"
      }
    ],
    "macOS": {
      "signingIdentity": "-",
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Mochi",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "visible": false
      },
      {
        "label": "pet",
        "url": "/#/pet",
        "title": "Mochi Pet",
        "width": 96,
        "height": 96,
        "center": true,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "acceptFirstMouse": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "focus": false,
        "dragDropEnabled": false
      },
      {
        "label": "pet-panel",
        "url": "/#/pet-panel",
        "title": "Mochi Pet Panel",
        "width": 440,
        "height": 620,
        "minWidth": 280,
        "minHeight": 360,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "shadow": true,
        "visible": false,
        "focus": true,
        "dragDropEnabled": false
      },
      {
        "label": "pet-bubble",
        "url": "/#/pet-bubble",
        "title": "Mochi Pet Bubble",
        "width": 320,
        "height": 120,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "focus": false,
        "dragDropEnabled": false
      },
      {
        "label": "pet-corner",
        "url": "/#/pet-corner",
        "title": "Mochi Pet Corner",
        "width": 320,
        "height": 80,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "focus": false,
        "dragDropEnabled": false
      },
      {
        "label": "pet-menu",
        "url": "/#/pet-menu",
        "title": "Mochi Pet Menu",
        "width": 220,
        "height": 320,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "focus": false,
        "dragDropEnabled": false
      },
      {
        "label": "voice-orb",
        "url": "/#/voice-orb",
        "title": "Mochi Voice Orb",
        "width": 460,
        "height": 180,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "focus": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**", "**/.*", "**/.*/**"],
          "deny": []
        }
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "fs": {
      "requireLiteralLeadingDot": false
    }
  }
}
