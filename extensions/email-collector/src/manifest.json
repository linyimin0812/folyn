{
  "id": "folyn-email-collector",
  "name": "Email Collector",
  "version": "0.1.0",
  "author": "Folyn",
  "folyn": ">=0.1.0",
  "tier": "trusted",
  "main": "dist/index.js",
  "icon": "@",
  "description": "邮件采集器 —— 轮询自定义 IMAP 邮箱（QQ/163/Gmail 等任意 IMAPS 服务器），将新邮件写入活动时间线（poll 模式，TLS）",
  "permissions": {
    "fs": { "scope": [] },
    "http": { "origins": [] },
    "clipboard": false,
    "dialog": false,
    "window": false,
    "vault": { "readActive": false, "insertContent": false, "readBinary": false },
    "ai": { "chat": false, "agents": [], "edit": false }
  },
  "contributes": {
    "collectors": [
      {
        "id": "email",
        "activityTypes": ["email_received"],
        "mode": "poll",
        "pollIntervalMs": 600000,
        "authSchema": {
          "type": "object",
          "properties": {
            "host": {
              "type": "string",
              "title": "IMAP 服务器（留空自动推断）",
              "description": "根据邮箱地址自动推断（gmail/qq/163/outlook 等已知，其余按 imap.<域名> 猜测）；推断失败时再手动填写，如 imap.example.com",
              "default": ""
            },
            "port": {
              "type": "number",
              "title": "端口",
              "description": "默认 993；仅支持 IMAPS（TLS），不支持明文/STARTTLS",
              "default": 993
            },
            "username": {
              "type": "string",
              "title": "邮箱账号",
              "description": "完整邮箱地址，如 you@example.com",
              "default": ""
            },
            "password": {
              "type": "string",
              "title": "密码 / 授权码",
              "description": "QQ/163 用授权码，Gmail 用应用专用密码；只存本机，绝不写入事件数据",
              "default": ""
            },
            "folder": {
              "type": "string",
              "title": "文件夹",
              "description": "默认 INBOX；仅支持 ASCII 文件夹名",
              "default": "INBOX"
            },
            "backfillDays": {
              "type": "number",
              "title": "首次回溯天数",
              "description": "首次采集时向回查看的天数",
              "default": 30
            },
            "allowAiSummary": {
              "type": "boolean",
              "title": "允许 AI 读取活动数据生成摘要",
              "description": "开启后，时间线详情面板可为该采集器的事件懒生成 AI 摘要",
              "default": false
            }
          },
          "required": ["username", "password"]
        },
        "hostAllowlist": []
      }
    ],
    "activityDisplay": [
      {
        "type": "email_received",
        "icon": "mail",
        "color": "blue",
        "detailFields": [
          { "key": "from", "label": "发件人", "format": "text" },
          { "key": "to", "label": "收件人", "format": "text" },
          { "key": "folder", "label": "文件夹", "format": "text" },
          { "key": "snippet", "label": "正文预览", "format": "text" }
        ],
        "metric": { "id": "email_count", "label": "邮件", "aggregate": "count" },
        "entity": { "role": "mailbox", "relationLabel": "邮箱" }
      }
    ],
    "entityTypes": [
      { "id": "mailbox", "label": "邮箱", "color": "blue", "icon": "mail" }
    ]
  }
}
