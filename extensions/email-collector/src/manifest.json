{
  "id": "folyn-email-collector",
  "name": "Email Collector",
  "version": "0.1.1",
  "author": "Folyn",
  "folyn": ">=0.1.0",
  "tier": "trusted",
  "main": "dist/index.js",
  "icon": "@",
  "description": "邮件采集器 —— 轮询多个自定义 IMAP 邮箱（QQ/163/Gmail 等任意 IMAPS 服务器），将新邮件写入活动时间线（poll 模式，TLS）",
  "permissions": {
    "fs": { "scope": [] },
    "http": { "origins": [] },
    "clipboard": false,
    "dialog": false,
    "window": false,
    "vault": { "readActive": false, "insertContent": false, "readBinary": false },
    "ai": { "chat": false, "agents": [], "edit": false }
  },
  "contributes": {
    "collectors": [
      {
        "id": "email",
        "activityTypes": ["email_received"],
        "mode": "poll",
        "pollIntervalMs": 600000,
        "authSchema": {
          "type": "object",
          "properties": {
            "allowAiSummary": {
              "type": "boolean",
              "title": "允许 AI 读取活动数据生成摘要",
              "description": "开启后，时间线详情面板可为该采集器的事件懒生成 AI 摘要",
              "default": false
            }
          },
          "required": []
        },
        "hostAllowlist": []
      }
    ],
    "activityDisplay": [
      {
        "type": "email_received",
        "icon": "mail",
        "color": "blue",
        "detailFields": [
          { "key": "mailbox", "label": "邮箱", "format": "text" },
          { "key": "from", "label": "发件人", "format": "text" },
          { "key": "to", "label": "收件人", "format": "text" },
          { "key": "folder", "label": "文件夹", "format": "text" },
          { "key": "bodyHtml", "label": "正文", "format": "html" }
        ],
        "metric": { "id": "email_count", "label": "邮件", "aggregate": "count" },
        "entity": { "role": "mailbox", "relationLabel": "邮箱" },
        "chips": [{ "key": "mailbox", "badge": "provider" }]
      }
    ],
    "entityTypes": [
      { "id": "mailbox", "label": "邮箱", "color": "blue", "icon": "mail" }
    ]
  }
}
