{
  "id": "folyn-github-collector",
  "name": "GitHub Collector",
  "version": "0.1.0",
  "author": "Folyn",
  "folyn": ">=0.1.0",
  "tier": "trusted",
  "main": "dist/index.js",
  "icon": "G",
  "description": "GitHub 活动采集器 —— 轮询读取用户的 GitHub 事件流（提交/PR/Issue），写入活动时间线（poll 模式）",
  "permissions": {
    "fs": { "scope": [] },
    "http": { "origins": ["https://api.github.com"] },
    "clipboard": false,
    "dialog": false,
    "window": false,
    "vault": { "readActive": false, "insertContent": false, "readBinary": false },
    "ai": { "chat": false, "agents": [], "edit": false }
  },
  "contributes": {
    "collectors": [
      {
        "id": "github",
        "activityTypes": ["commit", "github_pr", "github_issue"],
        "mode": "poll",
        "pollIntervalMs": 300000,
        "authSchema": {
          "type": "object",
          "properties": {
            "username": {
              "type": "string",
              "title": "GitHub 用户名",
              "description": "要采集其公开活动流的 GitHub 登录名",
              "default": ""
            },
            "token": {
              "type": "string",
              "title": "Personal Access Token（可选，公开仓库可留空）",
              "description": "用于读取私有事件流；令牌只存在本机，绝不写入事件数据",
              "default": ""
            },
            "allowAiSummary": {
              "type": "boolean",
              "title": "允许 AI 读取活动数据生成摘要",
              "description": "开启后，时间线详情面板可为该采集器的事件懒生成 AI 摘要",
              "default": false
            }
          },
          "required": ["username"]
        },
        "hostAllowlist": ["https://api.github.com"]
      }
    ],
    "activityDisplay": [
      {
        "type": "github_pr",
        "icon": "git-pull-request",
        "color": "purple",
        "detailFields": [
          { "key": "prNumber", "label": "PR", "format": "text" },
          { "key": "action", "label": "动作", "format": "text" },
          { "key": "repo", "label": "仓库", "format": "text" }
        ],
        "metric": { "id": "github_pr_count", "label": "PR", "aggregate": "count" },
        "entity": { "role": "repository", "relationLabel": "PR" }
      },
      {
        "type": "github_issue",
        "icon": "circle-dot",
        "color": "amber",
        "detailFields": [
          { "key": "issueNumber", "label": "Issue", "format": "text" },
          { "key": "action", "label": "动作", "format": "text" },
          { "key": "repo", "label": "仓库", "format": "text" }
        ],
        "metric": { "id": "github_issue_count", "label": "Issue", "aggregate": "count" },
        "entity": { "role": "repository", "relationLabel": "Issue" }
      }
    ]
  }
}
