{
  "id": "github-jsdelivr",
  "name": "GitHub + jsDelivr",
  "version": "0.1.0",
  "author": "Folyn",
  "folyn": ">=0.1.0",
  "tier": "trusted",
  "main": "dist/index.js",
  "icon": "github",
  "description": "图床 + HTML 分享：上传图片走 jsDelivr CDN（需公开仓库），上传的 HTML 走 GitHub Pages（需在仓库 Settings → Pages 开启）。需提供 GitHub 账户、仓库、分支与 Personal Access Token（repo 权限）。",
  "permissions": {
    "fs": { "scope": [] },
    "http": { "origins": ["https://api.github.com"] },
    "clipboard": false,
    "dialog": false,
    "window": false,
    "vault": { "readActive": false, "insertContent": false },
    "ai": { "chat": false, "agents": [], "edit": false }
  },
  "contributes": {
    "storageProviders": [
      {
        "id": "github-jsdelivr",
        "labelKey": "GitHub + jsDelivr",
        "icon": "github",
        "capabilities": { "image": true, "html": true },
        "configForm": "form",
        "isConfigured": "isConfigured",
        "uploadImage": "uploadImage",
        "uploadHtml": "uploadHtml",
        "defaultConfig": {
          "owner": "",
          "repo": "",
          "branch": "main",
          "token": "",
          "imageKeyPrefix": "images/",
          "htmlKeyPrefix": "html/"
        }
      }
    ]
  }
}
